{
  "name": "Baobab Subscriptions",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/baobab-subscriptions",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "baobab-verify --contract",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "github.vscode-github-actions",
        "redhat.vscode-yaml"
      ]
    }
  }
}
